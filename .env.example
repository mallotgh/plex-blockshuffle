# Öffentliche Basis-URL der App — dorthin leitet plex.tv nach dem Login zurück.
# Muss exakt die Adresse sein, unter der die App erreichbar ist.
APP_BASE_URL=https://plexshuffle.example.de

# Port des Webservers (Default 8973)
PORT=8973

# Verzeichnis für persistente Daten (SQLite + Client-ID). Im Container: /config
DATA_DIR=./data

# Anzeigename der App auf der Plex-Bestätigungsseite
PLEX_PRODUCT=Plex Blockshuffle
